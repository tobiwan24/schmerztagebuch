# "web"-Container: baut die Vite-PWA aus dem Repo-Root und liefert sie via
# nginx statisch aus, inkl. Reverse-Proxy von /api/* an den api-Container
# (siehe nginx.web.conf). Nur für den lokalen Test via docker-compose.yml im
# Repo-Root gedacht — der finale VM-Deploy (Tailnet-Hostname, Caddy davor)
# ist eine separate spätere Phase außerhalb dieses Worktrees.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
