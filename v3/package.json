{
  "name": "schmerztagebuch-v3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . && node scripts/check-ui-css.mjs",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "deps:check": "node scripts/check-deps.mjs",
    "verify": "npm run typecheck && npm run lint && npm run deps:check && npm run test && npm run build",
    "verify:docker": "node scripts/run-with-env.mjs STB_DOCKER=1 -- npm run verify",
    "acceptance": "node scripts/check-acceptance.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.7",
    "@playwright/test": "^1.65.0"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
