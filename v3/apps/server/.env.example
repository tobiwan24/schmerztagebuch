# Schmerztagebuch v3 — Server-Konfiguration (Spec 01). Alle Werte über Umgebungsvariablen; keine Secrets im Repo.

# WebAuthn Relying-Party-ID (Domain ohne Schema/Port), z. B. schmerztagebuch.example.org
RP_ID=localhost
# Kommagetrennte Liste erlaubter Origins (CORS + WebAuthn)
ALLOWED_ORIGINS=http://localhost:5173
# SQLite-Datei (relativ zum Arbeitsverzeichnis oder absolut)
DATABASE_PATH=./data/stb.sqlite
# Verzeichnis für verschlüsselte Anhänge
BLOB_DIR=./data/blobs
# optional
PORT=3000
HOST=0.0.0.0
# optional: Rate-Limits (Standard 30 Anmeldeversuche pro IP und Minute, 5 Recovery-Versuche je 15 Minuten)
# AUTH_RATE_LIMIT_PER_MIN=30
# RECOVERY_RATE_LIMIT_PER_15MIN=5

# optional: KI-Funktionen (Spec 08). Standard off. Der Klartext geht nur im RAM durch den Server und wird nie gespeichert.
# LLM_PROVIDER=off|ollama|anthropic
# LLM_DAILY_TOKENS=50000
# Ollama (eigener Server, keine Kosten pro Aufruf): OLLAMA_URL ist bei LLM_PROVIDER=ollama Pflicht
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# Anthropic (Drittanbieter, USA): ANTHROPIC_API_KEY ist bei LLM_PROVIDER=anthropic Pflicht, nie in Git ablegen
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
